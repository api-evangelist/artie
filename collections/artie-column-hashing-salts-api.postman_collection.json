          "id": "88dd9d20-875e-4b73-95fd-d572cbfd6e02",
          "name": "Preview a column hashing salt",
          "request": {
            "name": "Preview a column hashing salt",
            "description": {
              "content": "Hashes a sample string value with this salt using the same function used by Artie's pipelines (HMAC-SHA256 keyed on the salt, or SHA-256 if the salt is empty). Returns the hex-encoded hash.",
              "type": "text/plain"
            },
