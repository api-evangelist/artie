{
  "opencollection": "1.0.0",
  "info": {
    "name": "Artie Column Hashing Salts Ingestion API Keys API",
    "version": "v1.0.51"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Ingestion API Keys",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create an ingestion API key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.artie.com/ingestion-api-keys",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new ingestion API key for a source reader. Returns the key and its secret (only shown once)."
        },
        {
          "info": {
            "name": "Update an ingestion API key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.artie.com/ingestion-api-keys/:uuid",
            "params": [
              {
                "name": "uuid",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates an existing ingestion API key by UUID."
        },
        {
          "info": {
            "name": "Delete an ingestion API key",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.artie.com/ingestion-api-keys/:uuid",
            "params": [
              {
                "name": "uuid",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Deletes an ingestion API key by UUID."
        }
      ]
    }
  ],
  "bundled": true
}